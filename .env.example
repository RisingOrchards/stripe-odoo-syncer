# Stripe Odoo Syncer configuration.
# Copy to .env (never commit it), fill in, then load it with:  set -a; . ./.env; set +a

# --- Stripe -----------------------------------------------------------------
# Restricted key with READ access to: Balance, Balance transaction sources,
# Charges, Customers, Disputes, Payouts, Refunds.
STRIPE_API_KEY=rk_live_xxxxxxxxxxxxxxxx

# --- Odoo -------------------------------------------------------------------
# API key: Odoo > your avatar > My Profile/Preferences > Account Security > New API Key.
# The user needs accounting rights (e.g. Accounting / Accountant).
ODOO_URL=https://your-company.odoo.com
ODOO_DB=your-database-name
ODOO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Bank journal that represents your Stripe balance: name, short code, or numeric id.
ODOO_JOURNAL=Stripe
# json2 = Odoo 19 JSON-2 API (default). jsonrpc = legacy API; then also set ODOO_USER (login).
ODOO_API=json2
#ODOO_USER=accounting@your-company.com

# --- Sync window ------------------------------------------------------------
# Earliest date the syncer may book (YYYY-MM-DD): the day after your journal is complete up to.
SYNC_START=2026-01-01
# Timezone for statement line dates; use the one your Stripe account reports in.
SYNC_TZ=America/New_York
# Each run re-checks this many days before the newest synced line (duplicates are skipped).
#SYNC_OVERLAP_DAYS=3
#SYNC_LOCK_FILE=/tmp/stripe_odoo_sync.lock
#LOG_LEVEL=INFO

# --- Failure alerts ---------------------------------------------------------
ALERT_EMAIL=you@your-company.com
SMTP_HOST=smtp.your-provider.com
# 465 = implicit TLS; any other port uses STARTTLS.
SMTP_PORT=587
SMTP_USER=alerts@your-company.com
SMTP_PASSWORD=xxxxxxxx
SMTP_FROM=alerts@your-company.com
